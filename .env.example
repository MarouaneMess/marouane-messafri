# PostgreSQL, pooled URL supported. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Prefer immutable GitHub numeric ID. Username and verified email also supported.
ADMIN_GITHUB_ID=
ADMIN_GITHUB_USERNAME=
ADMIN_EMAIL=
GITHUB_USERNAME=
GITHUB_TOKEN=
SITE_URL=http://localhost:3000
CONTACT_EMAIL=
RESEND_API_KEY=
RESEND_FROM=
# Only enable behind a proxy that OVERWRITES x-forwarded-for.
TRUST_PROXY=false
